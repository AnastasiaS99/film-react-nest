{
  "compilerOptions": {
    "strict": true, // Включает все строгие проверки, в том числе:
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "module": "commonjs",
    "types": ["node", "jest"],
    "declaration": false,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": false,
    "noFallthroughCasesInSwitch": false
  }
}